  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('aplicacao UP', function () {",
                  "  var body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('UP');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/q/health",
              "host": ["{{base_url}}"],
              "path": ["q", "health"]
            }
          }
        }
      ]
    },
    {
      "name": "Avaliações",
      "item": [
        {
          "name": "Criar avaliação (crítica)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', function () { pm.response.to.have.status(201); });",
                  "var body = pm.response.json();",
                  "pm.test('retorna id, urgencia e dataEnvio', function () {",
                  "  pm.expect(body).to.have.property('id');",
                  "  pm.expect(body).to.have.property('urgencia');",
                  "  pm.expect(body).to.have.property('dataEnvio');",
                  "});",
                  "pm.test('nota 1 gera urgencia CRITICA', function () {",
                  "  pm.expect(body.urgencia).to.eql('CRITICA');",
                  "});",
                  "pm.environment.set('avaliacao_id', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descricao\": \"Aula com problemas graves de áudio, impossível acompanhar.\",\n  \"nota\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/avaliacao",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "avaliacao"]
            }
          }
        },
        {
          "name": "Criar avaliação (positiva)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('nota 9 gera urgencia BAIXA', function () {",
                  "  pm.expect(pm.response.json().urgencia).to.eql('BAIXA');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descricao\": \"Excelente aula, conteúdo muito claro.\",\n  \"nota\": 9\n}"
