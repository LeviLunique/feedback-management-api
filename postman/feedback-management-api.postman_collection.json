        {
          "name": "Listar avaliações (últimos 7 dias)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () { pm.response.to.have.status(200); });",
                  "var body = pm.response.json();",
                  "pm.test('devolve itens e total', function () {",
                  "  pm.expect(body.itens).to.be.an('array');",
                  "  pm.expect(body).to.have.property('total');",
                  "});",
                  "pm.test('total corresponde a quantidade de itens', function () {",
                  "  pm.expect(body.total).to.eql(body.itens.length);",
                  "});",
                  "pm.test('encontra a avaliacao registrada nesta execucao', function () {",
                  "  var ids = body.itens.map(function (i) { return i.id; });",
                  "  pm.expect(ids).to.include(pm.environment.get('avaliacao_id'));",
                  "});"
                ]
              }
            }
