          }
        },
        {
          "name": "Listar avaliações críticas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('todos os itens sao CRITICA', function () {",
                  "  var body = pm.response.json();",
                  "  body.itens.forEach(function (item) {",
                  "    pm.expect(item.urgencia).to.eql('CRITICA');",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/avaliacoes?urgencia=CRITICA",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "avaliacoes"],
              "query": [{ "key": "urgencia", "value": "CRITICA" }]
