        {
          "name": "Rejeita nota fora da escala (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', function () { pm.response.to.have.status(400); });",
                  "var body = pm.response.json();",
                  "pm.test('corpo de erro padrao', function () {",
                  "  pm.expect(body.status).to.eql(400);",
                  "  pm.expect(body).to.have.property('erro');",
                  "  pm.expect(body.mensagens).to.be.an('array').that.is.not.empty;",
                  "});",
                  "pm.test('mensagem aponta a nota', function () {",
                  "  pm.expect(body.mensagens.join(' ')).to.include('nota');",
                  "});",
                  "pm.test('nao vaza detalhes internos', function () {",
                  "  pm.expect(pm.response.text()).to.not.include('Exception');",
                  "  pm.expect(pm.response.text()).to.not.include('br.com.fiap');",
                  "});"
                ]
              }
            }
