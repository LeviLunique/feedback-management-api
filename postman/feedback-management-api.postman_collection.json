{
  "info": {
    "_postman_id": "b7f2a4a0-0000-4000-9000-feedback0004",
    "name": "feedback-management-api",
    "description": "Coleção de testes E2E da Feedback Management API (Tech Challenge FIAP - Fase 4). Contém apenas os endpoints já implementados; cada fase do roadmap adiciona seus próprios requests. Use o environment feedback-management-api.environment.json ({{base_url}}).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Monitoramento",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () { pm.response.to.have.status(200); });",
                  "var body = pm.response.json();",
                  "pm.test('aplicacao UP', function () {",
                  "  pm.expect(body.status).to.eql('UP');",
                  "});",
                  "pm.test('check da aplicacao expoe nome e versao', function () {",
                  "  var check = body.checks.find(function (c) { return c.name === 'aplicacao'; });",
                  "  pm.expect(check, 'check \"aplicacao\" presente').to.be.an('object');",
                  "  pm.expect(check.status).to.eql('UP');",
                  "  pm.expect(check.data).to.have.property('nome');",
                  "  pm.expect(check.data).to.have.property('versao');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/q/health",
              "host": ["{{base_url}}"],
              "path": ["q", "health"]
            },
            "description": "Verifica se a aplicação está no ar e qual build está ativa (RF-06)."
          }
        },
        {
          "name": "OpenAPI",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('especificacao publicada', function () {",
                  "  pm.expect(pm.response.text()).to.include('Feedback Management API');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/q/openapi",
              "host": ["{{base_url}}"],
              "path": ["q", "openapi"]
            },
            "description": "Documentação da API em OpenAPI 3."
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" }
  ]
}
