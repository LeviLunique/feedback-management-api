        {
          "name": "Listar avaliações",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('retorna itens e total', function () {",
                  "  var body = pm.response.json();",
                  "  pm.expect(body).to.have.property('itens');",
                  "  pm.expect(body).to.have.property('total');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
