    {
      "name": "Relatórios",
      "item": [
        {
          "name": "Relatório semanal",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('estrutura do relatorio', function () {",
                  "  var body = pm.response.json();",
                  "  pm.expect(body).to.have.property('inicio');",
                  "  pm.expect(body).to.have.property('fim');",
                  "  pm.expect(body).to.have.property('mediaNotas');",
                  "  pm.expect(body).to.have.property('totalAvaliacoes');",
                  "  pm.expect(body).to.have.property('avaliacoesPorDia');",
                  "  pm.expect(body).to.have.property('avaliacoesPorUrgencia');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/relatorios/semanal",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "relatorios", "semanal"]
            }
          }
        }
